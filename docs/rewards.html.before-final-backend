<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>My Rewards & Tokens - FormReady India</title>

<meta name="description"
content="Use FormReady India tools, earn tokens and redeem your rewards.">

<style>
*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f4f6fb;
  color:#111827;
}

header{
  background:#111827;
  color:white;
  padding:22px 16px;
  text-align:center;
}

header h1{
  margin:0;
  font-size:25px;
}

header p{
  margin:8px 0 0;
  color:#cbd5e1;
}

.container{
  width:min(700px,92%);
  margin:25px auto 50px;
}

.card{
  background:white;
  border-radius:18px;
  padding:22px;
  margin-bottom:18px;
  box-shadow:0 5px 20px #00000010;
}

.balance{
  background:#111827;
  color:white;
  text-align:center;
}

.balance .coin{
  font-size:38px;
}

.balance h2{
  font-size:34px;
  margin:8px 0;
}

.balance p{
  color:#cbd5e1;
  margin:5px 0;
}

.info{
  text-align:center;
  color:#475569;
  line-height:1.6;
}

h2{
  margin-top:0;
}

.redeem-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.redeem{
  border:1px solid #dbe1ea;
  background:#f8fafc;
  border-radius:14px;
  padding:16px;
  text-align:center;
  cursor:pointer;
  font-weight:700;
  font-size:16px;
}

.redeem:hover{
  background:#eef2ff;
}

.redeem.active{
  border:2px solid #2563eb;
  background:#eff6ff;
}

.redeem small{
  display:block;
  margin-top:5px;
  color:#64748b;
  font-weight:400;
}

label{
  display:block;
  margin:14px 0 7px;
  font-weight:700;
}

input{
  width:100%;
  padding:14px;
  border:1px solid #cbd5e1;
  border-radius:12px;
  font-size:16px;
  outline:none;
}

input:focus{
  border-color:#2563eb;
}

button{
  width:100%;
  margin-top:16px;
  padding:15px;
  border:0;
  border-radius:12px;
  background:#2563eb;
  color:white;
  font-size:16px;
  font-weight:800;
  cursor:pointer;
}

button:disabled{
  background:#94a3b8;
  cursor:not-allowed;
}

.note{
  font-size:13px;
  color:#64748b;
  text-align:center;
  line-height:1.5;
}

.status{
  display:none;
  padding:14px;
  border-radius:12px;
  margin-top:15px;
  text-align:center;
  font-weight:700;
}

.status.show{
  display:block;
}

.status.success{
  background:#dcfce7;
  color:#166534;
}

.status.error{
  background:#fee2e2;
  color:#991b1b;
}

.withdrawal-list{
  margin-top:15px;
}

.withdrawal-item{
  padding:14px;
  border:1px solid #e2e8f0;
  border-radius:12px;
  margin-top:10px;
  background:#f8fafc;
}

.withdrawal-item b{
  display:block;
  margin-bottom:5px;
}

.pending{
  color:#b45309;
}

.accepted{
  color:#166534;
}

.rejected{
  color:#991b1b;
}

.back{
  display:block;
  text-align:center;
  margin-top:20px;
  color:#2563eb;
  text-decoration:none;
  font-weight:700;
}

footer{
  text-align:center;
  padding:25px;
  color:#64748b;
  font-size:14px;
}

@media(max-width:450px){
  .redeem-grid{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>
  <h1>🪙 My Rewards & Tokens</h1>
  <p>FormReady India Rewards</p>
</header>

<div class="container">

  <div class="card balance">
    <div class="coin">🪙</div>
    <div>Your Token Balance</div>
    <h2 id="balance">0</h2>
    <p>100 Tokens = ₹1</p>
  </div>

  <div class="card info">
    <h2>🎁 Earn Tokens</h2>

    <p>
      Use eligible FormReady India tools and collect tokens.
    </p>

    <p>
      Your balance is securely maintained by the server.
    </p>

    <p>
      <b>Minimum withdrawal: ₹200</b>
    </p>
  </div>

  <div class="card">

    <h2>💰 Redeem Rewards</h2>

    <div class="redeem-grid">

      <div class="redeem active"
           data-amount="200"
           onclick="selectReward(200,this)">
        ₹200
        <small>20,000 Tokens</small>
      </div>

      <div class="redeem"
           data-amount="500"
           onclick="selectReward(500,this)">
        ₹500
        <small>50,000 Tokens</small>
      </div>

      <div class="redeem"
           data-amount="1000"
           onclick="selectReward(1000,this)">
        ₹1,000
        <small>1,00,000 Tokens</small>
      </div>

      <div class="redeem"
           data-amount="2000"
           onclick="selectReward(2000,this)">
        ₹2,000
        <small>2,00,000 Tokens</small>
      </div>

    </div>

    <label>Selected Reward</label>

    <input
      id="reward"
      value="₹200"
      readonly
    >

    <label>UPI ID</label>

    <input
      id="upi"
      type="text"
      maxlength="100"
      placeholder="example@upi"
      autocomplete="off"
    >

    <button
      id="requestBtn"
      onclick="requestReward()">
      Request Withdrawal
    </button>

    <div id="status" class="status"></div>

    <p class="note">
      Withdrawal requests are reviewed before payment.
      Rejected requests return the tokens to your balance.
    </p>

  </div>

  <div class="card">

    <h2>📋 My Withdrawal Requests</h2>

    <div id="withdrawals"
         class="withdrawal-list">
      Loading...
    </div>

  </div>

  <a class="back" href="index.html">
    ← Back to FormReady India
  </a>

</div>

<footer>
  © 2026 FormReady India. All rights reserved.
</footer>

<script>

let userKey = localStorage.getItem("formready_user_key") || "";
let selectedReward = 200;
let balance = 0;

function showStatus(message,type){

  const box = document.getElementById("status");

  box.textContent = message;

  box.className =
    "status show " + type;
}

function hideStatus(){

  const box = document.getElementById("status");

  box.className = "status";
}

function saveUserKey(key){

  if(!key) return;

  userKey = key;

  localStorage.setItem(
    "formready_user_key",
    key
  );
}

async function apiFetch(url,options={}){

  options.headers = {
    ...(options.headers || {}),
    "Content-Type":"application/json"
  };

  if(userKey){

    options.headers["X-User-Key"] = userKey;
  }

  const response = await fetch(url,options);

  const newKey =
    response.headers.get("X-User-Key");

  if(newKey){

    saveUserKey(newKey);
  }

  const data = await response.json();

  return {
    response,
    data
  };
}

async function loadBalance(){

  try{

    const result =
      await apiFetch("/api/token/balance");

    if(result.data.userKey){

      saveUserKey(result.data.userKey);
    }

    if(result.data.success){

      balance =
        Number(result.data.tokens || 0);

      document.getElementById("balance")
        .textContent =
        balance.toLocaleString("en-IN");
    }

  }catch(error){

    console.error(error);

    showStatus(
      "Unable to load token balance.",
      "error"
    );
  }
}

function selectReward(amount,element){

  selectedReward = amount;

  document.getElementById("reward").value =
    "₹" + amount.toLocaleString("en-IN");

  document.querySelectorAll(".redeem")
    .forEach(item => {
      item.classList.remove("active");
    });

  if(element){

    element.classList.add("active");
  }

  hideStatus();
}

async function requestReward(){

  const upi =
    document.getElementById("upi")
      .value.trim();

  const button =
    document.getElementById("requestBtn");

  const required =
    selectedReward * 100;

  hideStatus();

  if(!upi){

    showStatus(
      "Please enter your UPI ID.",
      "error"
    );

    return;
  }

  if(balance < required){

    showStatus(
      "Not enough tokens. Required: " +
      required.toLocaleString("en-IN") +
      " tokens.",
      "error"
    );

    return;
  }

  const confirmRequest =
    confirm(
      "Request ₹" +
      selectedReward.toLocaleString("en-IN") +
      " withdrawal?\n\n" +
      "Tokens required: " +
      required.toLocaleString("en-IN") +
      "\nUPI: " +
      upi
    );

  if(!confirmRequest) return;

  button.disabled = true;
  button.textContent = "Submitting...";

  try{

    const result =
      await apiFetch(
        "/api/token/withdraw",
        {
          method:"POST",
          body:JSON.stringify({
            amount:selectedReward,
            upi:upi
          })
        }
      );

    if(result.data.success){

      balance =
        Number(result.data.balance || 0);

      document.getElementById("balance")
        .textContent =
        balance.toLocaleString("en-IN");

      document.getElementById("upi")
        .value = "";

      showStatus(
        "✅ Withdrawal request submitted successfully.",
        "success"
      );

      loadWithdrawals();

    }else{

      showStatus(
        result.data.error ||
        "Unable to submit withdrawal request.",
        "error"
      );

      if(result.data.balance !== undefined){

        balance =
          Number(result.data.balance);

        document.getElementById("balance")
          .textContent =
          balance.toLocaleString("en-IN");
      }
    }

  }catch(error){

    console.error(error);

    showStatus(
      "Server error. Please try again.",
      "error"
    );

  }finally{

    button.disabled = false;
    button.textContent = "Request Withdrawal";
  }
}

async function loadWithdrawals(){

  const container =
    document.getElementById("withdrawals");

  try{

    const result =
      await apiFetch(
        "/api/token/withdrawals"
      );

    if(!result.data.success){

      container.textContent =
        "Unable to load requests.";

      return;
    }

    const list =
      result.data.withdrawals || [];

    if(list.length === 0){

      container.innerHTML =
        "<p>No withdrawal requests yet.</p>";

      return;
    }

    container.innerHTML = "";

    list.forEach(item => {

      const div =
        document.createElement("div");

      div.className =
        "withdrawal-item";

      const status =
        String(item.status || "pending");

      const date =
        item.createdAt
          ? new Date(item.createdAt)
              .toLocaleString("en-IN")
          : "";

      div.innerHTML =
        "<b>₹" +
        Number(item.amount)
          .toLocaleString("en-IN") +
        "</b>" +

        "<span class='" +
        status +
        "'>" +
        status.toUpperCase() +
        "</span>" +

        "<br>" +

        "<small>" +
        Number(item.tokens)
          .toLocaleString("en-IN") +
        " tokens • " +
        date +
        "</small>";

      container.appendChild(div);

    });

  }catch(error){

    console.error(error);

    container.textContent =
      "Unable to load requests.";
  }
}

loadBalance();
loadWithdrawals();

</script>

</body>
</html>
