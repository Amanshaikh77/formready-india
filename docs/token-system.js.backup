(function () {
  "use strict";

  const USER_KEY = "formready_user_key";

  const REWARDS = {
    "jpg-to-pdf": 20,
    "merge-pdf": 25,
    "passport-photo": 25,
    "pdf-compressor": 25,
    "pdf-to-jpg": 20,
    "photo-compressor": 20,
    "photo-resizer": 20,
    "photo-sheet": 25,
    "signature-maker": 20,
    "split-pdf": 25
  };

  const WITHDRAWALS = [
    { amount: 200, tokens: 20000 },
    { amount: 500, tokens: 50000 },
    { amount: 1000, tokens: 100000 },
    { amount: 2000, tokens: 200000 }
  ];

  function getUserKey() {
    return localStorage.getItem(USER_KEY) || "";
  }

  function saveUserKey(key) {
    if (key) {
      localStorage.setItem(USER_KEY, key);
    }
  }

  async function api(url, options = {}) {
    const headers = {
      ...(options.headers || {})
    };

    const userKey = getUserKey();

    if (userKey) {
      headers["X-User-Key"] = userKey;
    }

    if (options.body && !headers["Content-Type"]) {
      headers["Content-Type"] = "application/json";
    }

    const response = await fetch(url, {
      ...options,
      headers
    });

    const newUserKey =
      response.headers.get("X-User-Key");

    if (newUserKey) {
      saveUserKey(newUserKey);
    }

    return response.json();
  }

  async function getTokens() {
    try {
      const data = await api("/api/token/balance");

      if (data.userKey) {
        saveUserKey(data.userKey);
      }

      return Number(data.tokens || 0);
    } catch (error) {
      console.error("Token balance error:", error);
      return 0;
    }
  }

  async function addTokens(toolName) {
    const reward = REWARDS[toolName];

    if (!reward) {
      return {
        success: false,
        error: "Invalid tool"
      };
    }

    /*
      Daily reward protection is kept on the server side
      by this browser key only as a first layer.
    */

    const todayKey =
      "formready_reward_" +
      toolName +
      "_" +
      new Date().toISOString().slice(0, 10);

    if (localStorage.getItem(todayKey)) {
      return {
        success: false,
        error: "Already rewarded today"
      };
    }

    try {
      const data = await api(
        "/api/token/earn",
        {
          method: "POST",
          body: JSON.stringify({
            amount: reward,
            tool: toolName
          })
        }
      );

      if (data.success) {

        localStorage.setItem(todayKey, "1");

        updateWallet(data.balance);

        showToast(
          "+" + reward + " 🪙 Tokens earned!"
        );
      }

      return data;

    } catch (error) {

      console.error("Token earn error:", error);

      return {
        success: false,
        error: "Unable to earn tokens"
      };
    }
  }

  async function updateWallet(serverBalance) {

    let balance = serverBalance;

    if (balance === undefined) {
      balance = await getTokens();
    }

    document
      .querySelectorAll("[data-token-balance]")
      .forEach(el => {
        el.textContent =
          Number(balance).toLocaleString("en-IN") +
          " 🪙";
      });

    const balanceElement =
      document.getElementById("balance");

    if (balanceElement) {
      balanceElement.textContent =
        Number(balance).toLocaleString("en-IN");
    }

    return balance;
  }

  function showToast(message) {

    let toast =
      document.getElementById("token-toast");

    if (!toast) {

      toast = document.createElement("div");

      toast.id = "token-toast";

      toast.style.cssText =
        "position:fixed;" +
        "bottom:20px;" +
        "left:50%;" +
        "transform:translateX(-50%);" +
        "background:#111;" +
        "color:#fff;" +
        "padding:12px 18px;" +
        "border-radius:12px;" +
        "z-index:99999;" +
        "font-weight:600;" +
        "box-shadow:0 5px 20px #0004;";

      document.body.appendChild(toast);
    }

    toast.textContent = message;
    toast.style.display = "block";

    clearTimeout(
      window.__tokenToastTimer
    );

    window.__tokenToastTimer =
      setTimeout(() => {
        toast.style.display = "none";
      }, 2500);
  }

  window.FormReadyTokens = {
    getTokens,
    addTokens,
    updateWallet,
    rewards: REWARDS,
    withdrawals: WITHDRAWALS
  };

  document.addEventListener(
    "DOMContentLoaded",
    () => {
      updateWallet();
    }
  );

})();
