  padding:24px;
  text-decoration:none;
  color:#111827;
  box-shadow:0 7px 25px #00000008;
  transition:.2s;
}

.tool:hover{
  transform:translateY(-5px);
  box-shadow:0 15px 35px #00000012;
}

.tool-icon{
  width:55px;
  height:55px;
  display:flex;
