const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const DB_FILE = path.join(__dirname, "tokens.json");

function loadDB() {
    if (!fs.existsSync(DB_FILE)) {
        const initial = {
            users: {},
            history: []
        };
        fs.writeFileSync(DB_FILE, JSON.stringify(initial, null, 2));
        return initial;
    }

    try {
        return JSON.parse(fs.readFileSync(DB_FILE, "utf8"));
    } catch {
        return { users: {}, history: [] };
    }
}

function saveDB(db) {
    fs.writeFileSync(DB_FILE, JSON.stringify(db, null, 2));
}

function createUser() {
    const db = loadDB();

    const userKey = crypto.randomUUID();

    db.users[userKey] = {
        tokens: 0,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
    };

    saveDB(db);

    return userKey;
}

function getUser(userKey) {
    const db = loadDB();

    if (!db.users[userKey]) {
        db.users[userKey] = {
            tokens: 0,
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
        };

        saveDB(db);
    }

    return db.users[userKey];
}

function getTokens(userKey) {
    return getUser(userKey).tokens;
}

function addTokens(userKey, amount, tool = "unknown") {
    const db = loadDB();
    const user = getUser(userKey);

    user.tokens += Number(amount);
    user.updatedAt = new Date().toISOString();

    db.history.push({
        userKey,
        tool,
        type: "earn",
        tokens: Number(amount),
        createdAt: new Date().toISOString()
    });

    saveDB(db);

    return user.tokens;
}

function spendTokens(userKey, amount, tool = "unknown") {
    const db = loadDB();
    const user = getUser(userKey);
    const cost = Number(amount);

    if (user.tokens < cost) {
        return {
            success: false,
            balance: user.tokens
        };
    }

    user.tokens -= cost;
    user.updatedAt = new Date().toISOString();

    db.history.push({
        userKey,
        tool,
        type: "spend",
        tokens: cost,
        createdAt: new Date().toISOString()
    });

    saveDB(db);

    return {
        success: true,
        balance: user.tokens
    };
}


function createWithdrawal(userKey, amount, upi) {
    const db = loadDB();
    const user = getUser(userKey);
    const rupees = Number(amount);
    const tokensRequired = rupees * 100;

    if (![200, 500, 1000, 2000].includes(rupees)) {
        return { success: false, error: "Invalid withdrawal amount" };
    }

    if (!upi || String(upi).trim().length < 3) {
        return { success: false, error: "Invalid UPI ID" };
    }

    if (user.tokens < tokensRequired) {
        return {
            success: false,
            error: "Not enough tokens",
            balance: user.tokens,
            required: tokensRequired
        };
    }

    user.tokens -= tokensRequired;
    user.updatedAt = new Date().toISOString();

    const request = {
        id: crypto.randomUUID(),
        userKey,
        amount: rupees,
        tokens: tokensRequired,
        upi: String(upi).trim(),
        status: "pending",
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
    };

    if (!db.withdrawals) db.withdrawals = [];
    db.withdrawals.push(request);

    db.history.push({
        userKey,
        type: "withdrawal",
        tokens: tokensRequired,
        amount: rupees,
        status: "pending",
        createdAt: new Date().toISOString()
    });

    saveDB(db);
    return { success: true, request, balance: user.tokens };
}

function getWithdrawals() {
    const db = loadDB();
    return db.withdrawals || [];
}

function updateWithdrawal(requestId, status) {
    const db = loadDB();
    if (!db.withdrawals) db.withdrawals = [];

    const request = db.withdrawals.find(r => r.id === requestId);

    if (!request) {
        return { success: false, error: "Withdrawal request not found" };
    }

    if (!["accepted", "rejected"].includes(status)) {
        return { success: false, error: "Invalid status" };
    }

    if (request.status !== "pending") {
        return { success: false, error: "Request already processed" };
    }

    request.status = status;
    request.updatedAt = new Date().toISOString();

    if (status === "rejected") {
        const user = getUser(request.userKey);
        user.tokens += request.tokens;
        user.updatedAt = new Date().toISOString();
    }

    db.history.push({
        userKey: request.userKey,
        type: "withdrawal-" + status,
        tokens: request.tokens,
        amount: request.amount,
        createdAt: new Date().toISOString()
    });

    saveDB(db);

    return {
        success: true,
        request,
        balance: getTokens(request.userKey)
    };
}

module.exports = {
    createUser,
    getUser,
    getTokens,
    addTokens,
    spendTokens,
    createWithdrawal,
    getWithdrawals,
    updateWithdrawal
};
