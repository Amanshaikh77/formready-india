const express = require("express");
const path = require("path");
const fs = require("fs");
const crypto = require("crypto");

const tokenDB = require("./token-db");

const app = express();
const PORT = 3000;

const PUBLIC = path.join(__dirname, "docs");

app.use(express.json({ limit: "50mb" }));
app.use(express.urlencoded({
    extended: true,
    limit: "50mb"
}));

app.use(express.static(PUBLIC));

/* =========================
   USER SYSTEM
========================= */

function getUserKey(req, res) {

    let userKey = req.headers["x-user-key"];

    if (
        !userKey ||
        typeof userKey !== "string" ||
        userKey.length > 200
    ) {
        userKey = crypto.randomUUID();
    }

    tokenDB.getUser(userKey);

    res.setHeader("X-User-Key", userKey);

    return userKey;
}

/* =========================
   TOKEN BALANCE
========================= */

app.get("/api/token/balance", (req, res) => {

    try {

        const userKey = getUserKey(req, res);

        const tokens =
            tokenDB.getTokens(userKey);

        res.json({
            success: true,
            userKey,
            tokens
        });

    } catch (error) {

        console.error("Balance Error:", error);

        res.status(500).json({
            success: false,
            error: "Unable to get token balance"
        });
    }
});

/* =========================
   EARN TOKENS
========================= */

app.post("/api/token/earn", (req, res) => {

    try {

        const userKey = getUserKey(req, res);

        const amount =
            Number(req.body.amount || 0);

        const tool =
            String(
                req.body.tool || "unknown-tool"
            );

        if (
            !Number.isFinite(amount) ||
            amount <= 0 ||
            amount > 1000
        ) {
            return res.status(400).json({
                success: false,
                error: "Invalid token amount"
            });
        }

        const balance =
            tokenDB.addTokens(
                userKey,
                amount,
                tool
            );

        res.json({
            success: true,
            earned: amount,
            balance
        });

    } catch (error) {

        console.error("Earn Error:", error);

        res.status(500).json({
            success: false,
            error: "Unable to add tokens"
        });
    }
});

/* =========================
   SPEND TOKENS
========================= */

app.post("/api/token/spend", (req, res) => {

    try {

        const userKey = getUserKey(req, res);

        const amount =
            Number(req.body.amount || 0);

        const tool =
            String(
                req.body.tool || "unknown-tool"
            );

        if (
            !Number.isFinite(amount) ||
            amount <= 0
        ) {
            return res.status(400).json({
                success: false,
                error: "Invalid token amount"
            });
        }

        const result =
            tokenDB.spendTokens(
                userKey,
                amount,
                tool
            );

        if (!result.success) {

            return res.status(402).json({
                success: false,
                error: "Not enough tokens",
                balance: result.balance
            });
        }

        res.json({
            success: true,
            spent: amount,
            balance: result.balance
        });

    } catch (error) {

        console.error("Spend Error:", error);

        res.status(500).json({
            success: false,
            error: "Unable to spend tokens"
        });
    }
});

/* =========================
   WITHDRAWAL REQUEST
   100 TOKENS = ₹1
   MINIMUM ₹200
========================= */

app.post("/api/token/withdraw", (req, res) => {

    try {

        const userKey = getUserKey(req, res);

        const amount =
            Number(req.body.amount || 0);

        const upi =
            String(req.body.upi || "").trim();

        const allowedAmounts = [
            200,
            500,
            1000,
            2000
        ];

        if (!allowedAmounts.includes(amount)) {

            return res.status(400).json({
                success: false,
                error:
                    "Invalid withdrawal amount"
            });
        }

        if (!upi || upi.length < 3) {

            return res.status(400).json({
                success: false,
                error: "Invalid UPI ID"
            });
        }

        const tokensRequired =
            amount * 100;

        const user =
            tokenDB.getUser(userKey);

        if (user.tokens < tokensRequired) {

            return res.status(400).json({
                success: false,
                error: "Not enough tokens",
                balance: user.tokens,
                required: tokensRequired
            });
        }

        const result =
            tokenDB.createWithdrawal(
                userKey,
                amount,
                upi
            );

        if (!result.success) {

            return res.status(400).json(result);
        }

        res.json({
            success: true,
            request: result.request,
            balance: result.balance
        });

    } catch (error) {

        console.error(
            "Withdrawal Error:",
            error
        );

        res.status(500).json({
            success: false,
            error:
                "Unable to create withdrawal request"
        });
    }
});

/* =========================
   USER WITHDRAWAL HISTORY
========================= */

app.get(
    "/api/token/withdrawals",
    (req, res) => {

        try {

            const userKey =
                getUserKey(req, res);

            const all =
                tokenDB.getWithdrawals();

            const withdrawals =
                all.filter(
                    item =>
                        item.userKey === userKey
                );

            res.json({
                success: true,
                withdrawals
            });

        } catch (error) {

            console.error(
                "Withdrawals Error:",
                error
            );

            res.status(500).json({
                success: false,
                error:
                    "Unable to get withdrawals"
            });
        }
    }
);

