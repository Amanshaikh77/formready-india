/* =========================
   DIRECT TOOL FILES
========================= */

app.get(
    "/tools/:tool.html",
    (req, res, next) => {

        const tool =
            req.params.tool;

        if (
            !/^[a-zA-Z0-9_-]+$/.test(tool)
        ) {
            return res.status(400)
                .send("Invalid tool name");
        }

        const file =
            path.join(
                PUBLIC,
                "tools",
                tool + ".html"
            );

        if (fs.existsSync(file)) {
            return res.sendFile(file);
        }

        next();
    }
);

