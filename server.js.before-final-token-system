app.post(
    "/api/admin/withdrawal/update",
    (req, res) => {

        try {

            const requestId =
                String(
                    req.body.requestId || ""
                );

            const status =
                String(
                    req.body.status || ""
                );

            if (!requestId) {

                return res.status(400).json({
                    success: false,
                    error:
                        "Request ID required"
                });
            }

            if (
                !["accepted", "rejected"]
                .includes(status)
            ) {

                return res.status(400).json({
                    success: false,
                    error:
                        "Invalid withdrawal status"
                });
            }

            const result =
                tokenDB.updateWithdrawal(
                    requestId,
                    status
                );

            if (!result.success) {

                return res.status(400).json(
                    result
                );
            }

            res.json(result);

        } catch (error) {

            console.error(
                "Update Withdrawal Error:",
                error
            );

            res.status(500).json({
                success: false,
                error:
                    "Unable to update withdrawal"
            });
        }
    }
);

